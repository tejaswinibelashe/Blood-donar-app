<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BloodLink" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_red</item>
        <item name="colorPrimaryVariant">@color/dark_red_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background colors. -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">@color/surface_dark</item>
    </style>

    <style name="Theme.BloodLink.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
